# Copy this file to .env for local development, or configure the same
# variables in your hosting provider (e.g. Railway) for deployment.
# Never commit a real .env file — it is gitignored on purpose.

# --- Database ---------------------------------------------------------------
# Local Postgres example:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dsf_consult?schema=public"
# Railway Postgres: copy the "DATABASE_URL" connection string from the Railway
# project's Postgres plugin (Variables tab) once the project is provisioned.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dsf_consult?schema=public"

# --- CRM authentication -------------------------------------------------------
# Secret used to sign CRM session cookies. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# --- Booking ------------------------------------------------------------------
# If set, "Book a Strategy Call" CTAs link directly to this URL (Calendly,
# Google Calendar booking page, etc). If unset, /book shows a polished
# "coming soon" placeholder instead.
NEXT_PUBLIC_BOOKING_URL=

# --- Invoice / company branding (all optional — see src/lib/settings/invoice.ts) -
# INVOICE_COMPANY_NAME="DSF Consult"
# INVOICE_LOGO_PATH=                 # path under /public, e.g. /images/logo.png
# INVOICE_BUSINESS_EMAIL="billing@dsfconsult.com"
# INVOICE_PHONE=
# INVOICE_ADDRESS=
# INVOICE_FOOTER="Thank you for your business."
# INVOICE_DEFAULT_CURRENCY="CAD"     # CAD | USD | NGN
# INVOICE_DEFAULT_TAX_LABEL="Tax"
# INVOICE_DEFAULT_TAX_RATE=0         # percent, e.g. 13 for 13% HST
# INVOICE_PAYMENT_INSTRUCTIONS=

